@article{ WOS:000452126600014,
Author = {Farghly, Mohamed F. A. and Mahrose, Khalid M. and Cooper, Ross G. and
   Ullah, Z. and Rehman, Z. and Ding, C.},
Title = {Sustainable floor type for managing turkey production in a hot climate},
