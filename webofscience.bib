Journal = {BRAZILIAN JOURNAL OF POULTRY SCIENCE},
Year = {2015},
Volume = {17},
Number = {1},
Pages = {37-43},
Month = {JAN-MAR},
Abstract = {The objective of this study was to determine the critical points of the
   operation of broiler catching for transport to the processing plant from
   animal and operational perspectives. During catching, chickens,
   environmental variables (temperature and relative humidity) were
   constantly monitored to determine the Enthalpy Comfort Index (IEC).
   Also, the physiological variable rectal temperature (RT) was monitored
   as an indicator of stress suffered by the birds during this handling
   procedure. Bird welfare were evaluated by analyzing their behavior. The
   bag method was effective to prevent the struggling of birds while being
   taken from the broiler house to the transport truck, reducing physical
   injuries and losses during catching.},
